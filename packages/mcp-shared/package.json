{
  "name": "@pact-community/mcp-shared",
  "version": "1.0.0",
  "description": "Shared security baseline and utilities for Pact Community MCP servers",
  "type": "module",
  "private": false,
  "engines": {
    "node": ">=20.11.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/**/*",
    "README.md",
    "SECURITY.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc --build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "echo 'lint: skipped for Phase 1.1'",
    "clean": "rm -rf dist tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "25.9.3",
    "@vitest/coverage-v8": "4.1.9",
    "typescript": "6.0.3",
    "vitest": "4.1.9"
  },
  "author": "Pact Community",
  "license": "MIT",
  "homepage": "https://github.com/Pact-Community-Organization/pact-mcp/tree/main/packages/mcp-shared#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Pact-Community-Organization/pact-mcp.git",
    "directory": "packages/mcp-shared"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}