{
  "name": "@pact-community/mcp-coordination",
  "version": "0.2.0",
  "description": "MCP server for Pact Community multi-agent coordination \u2014 task queue, mailbox, status, memory.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20.11.0"
  },
  "main": "./dist/server.js",
  "types": "./dist/server.d.ts",
  "bin": {
    "pact-community-coordination": "./dist/bin.js"
  },
  "files": [
    "dist/**/*",
    "README.md",
    "SECURITY.md",
    "CHANGELOG.md",
    "tools.lock.json"
  ],
  "scripts": {
    "build": "tsc --build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "@pact-community/mcp-shared": "workspace:*",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "25.9.5",
    "@vitest/coverage-v8": "4.1.10",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  },
  "author": "Pact Community",
  "license": "Apache-2.0",
  "homepage": "https://github.com/Pact-Community-Organization/pact-mcp/tree/main/packages/mcp-coordination#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Pact-Community-Organization/pact-mcp.git",
    "directory": "packages/mcp-coordination"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "pact",
    "kadena",
    "chainweb",
    "blockchain",
    "smart-contracts"
  ],
  "bugs": {
    "url": "https://github.com/Pact-Community-Organization/pact-mcp/issues"
  }
}
