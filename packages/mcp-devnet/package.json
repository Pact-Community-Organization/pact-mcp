{
  "name": "@pact-community/mcp-devnet",
  "version": "0.1.0",
  "description": "MCP server for KDA-CE devnet lifecycle \u2014 gated docker compose tools for Developer/Tester/Security agents.",
  "type": "module",
  "private": false,
  "engines": {
    "node": ">=20.11.0"
  },
  "main": "./dist/server.js",
  "types": "./dist/server.d.ts",
  "bin": {
    "pact-community-devnet": "./dist/bin.js"
  },
  "files": [
    "dist/**/*",
    "README.md",
    "SECURITY.md",
    "CHANGELOG.md",
    "tools.lock.json",
    "server.json"
  ],
  "scripts": {
    "build": "tsc --build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "@pact-community/mcp-shared": "workspace:*",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "25.9.3",
    "@vitest/coverage-v8": "4.1.9",
    "typescript": "6.0.3",
    "vitest": "4.1.9"
  },
  "author": "Pact Community",
  "license": "Apache-2.0",
  "homepage": "https://github.com/Pact-Community-Organization/pact-mcp/tree/main/packages/mcp-devnet#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Pact-Community-Organization/pact-mcp.git",
    "directory": "packages/mcp-devnet"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "pact",
    "kadena",
    "chainweb",
    "blockchain",
    "smart-contracts"
  ],
  "bugs": {
    "url": "https://github.com/Pact-Community-Organization/pact-mcp/issues"
  },
  "mcpName": "io.github.pact-community-organization/devnet"
}
