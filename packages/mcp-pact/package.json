{
  "name": "@pact-community/mcp-pact",
  "version": "0.2.0",
  "description": "MCP server for Pact 5 smart contract tooling - REPL testing, module scanning, gas analysis, interface diff, fmt check",
  "type": "module",
  "private": false,
  "engines": {
    "node": ">=20.11.0"
  },
  "main": "./dist/server.js",
  "types": "./dist/server.d.ts",
  "bin": {
    "pact-community-pact": "./dist/bin.js"
  },
  "files": [
    "dist/**/*",
    "README.md",
    "SECURITY.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc --build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "echo 'lint: skipped for Phase 1.2'",
    "clean": "rm -rf dist tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "@pact-community/mcp-shared": "workspace:*",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "20.11.0",
    "@vitest/coverage-v8": "3.2.4",
    "typescript": "5.6.3",
    "vitest": "4.1.8"
  },
  "author": "Pact Community",
  "license": "MIT",
  "homepage": "https://github.com/Pact-Community-Organization/pact-mcp/tree/main/packages/mcp-pact#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Pact-Community-Organization/pact-mcp.git",
    "directory": "packages/mcp-pact"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}