    "audit": "pnpm -r audit --audit-level=high"
  },
  "devDependencies": {
    "@types/node": "20.11.0",
    "eslint": "9.15.0",
    "prettier": "3.3.3",
    "typescript": "5.6.3",
    "vitest": "4.1.7"
  },
  "packageManager": "pnpm@9.15.1",
  "pnpm": {
    "overrides": {
      "zod-to-json-schema": "3.25.2"
    }
  },
