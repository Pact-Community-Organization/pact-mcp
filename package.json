{
  "name": "@pact-community/mcp-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Pact Community Model Context Protocol servers monorepo",
  "engines": {
    "node": ">=20.11.0",
    "pnpm": ">=9"
  },
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "test:e2e:devnet": "pnpm --filter @pact-community/mcp-chainweb test:e2e:devnet",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "audit": "pnpm -r audit --audit-level=high"
  },
  "devDependencies": {
    "@types/node": "25.9.3",
    "eslint": "10.5.0",
    "prettier": "3.8.4",
    "typescript": "6.0.3",
    "vitest": "4.1.9"
  },
  "packageManager": "pnpm@9.15.1",
  "pnpm": {
    "overrides": {
      "zod-to-json-schema": "3.25.2"
    }
  },
  "author": "Pact Community",
  "license": "MIT",
  "homepage": "https://github.com/Pact-Community-Organization/pact-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Pact-Community-Organization/pact-mcp.git"
  },
  "keywords": [
    "mcp",
    "pact",
    "kadena",
    "chainweb"
  ]
}